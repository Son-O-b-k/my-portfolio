{
  "name": "success-on-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio for Success .O.N — Platform & Cloud Engineer.",
  "author": "Success .O.N",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "sass --no-source-map --style=compressed public_html/assets/scss/johndoe.scss public_html/assets/css/johndoe.css",
    "dev:css": "sass --no-source-map --style=expanded public_html/assets/scss/johndoe.scss public_html/assets/css/johndoe.css",
    "watch": "sass --no-source-map --watch public_html/assets/scss/johndoe.scss:public_html/assets/css/johndoe.css",
    "serve": "npx --yes http-server public_html -p 8080 -c-1",
    "start": "npm run watch"
  },
  "devDependencies": {
    "sass": "^1.77.8"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
